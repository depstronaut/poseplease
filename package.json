{
  "name": "poseplease-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test --experimental-strip-types tests/**/*.test.ts",
    "start": "node scripts/dev.js"
  }
}